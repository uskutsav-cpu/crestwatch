  "impacts": [
   {
    "stage": 43.28,
    "statement": "Major flooding is occurring along the river from Northeast Jackson to Flowood toRichland and Byram."
   },
   {
    "stage": 38,
    "statement": "A large number of homes are flooded in Northeast Jackson and water is in some buildings in Downtown Jackson."
   },
   {
    "stage": 35.79,
    "statement": "Water is close to entering homes in Northeast Jackson."
   },
   {
    "stage": 35.4,
    "statement": "Water approaches homes in the Hightower Area."
   },
   {
    "stage": 35,
    "statement": "Some businesses are affected near Town Creek. River waters will flood some of the streets of Northeast Jackson subdivisions which are close to the river and a number of additional streets in downtown Jackson."
   },
   {
    "stage": 34,
    "statement": "Dozens of additional streets flood in downtown Jackson."
   },
   {
    "stage": 33,
    "statement": "Rosemary Road is closed. Sidney Street is impassable. There is water on West Street. The playing field off Westbrook Road is underwater. Water is on Nichols and Julienne streets in the Hightower Area; however, both are passable. Water is approaching packs auto detail shop on South West Street."
   },
   {
    "stage": 32,
    "statement": "Water begins to affect businesses on South President and South Farish streets. Sidney Street is flooded."
   },
   {
    "stage": 31,
    "statement": "Water begins to impact approaches to additional homes and businesses in the Byram area."
   },
   {
    "stage": 30,
    "statement": "Water backs up into several creeks and streams in the Jackson area. Water is under some homes near the river in the Byram area."
   },
   {
    "stage": 29,
    "statement": "Farmland in southern Rankin County begins to flood and water begins to affect home access near the river in the Byram area."
   },
   {
    "stage": 28,
    "statement": "Minor flooding of lowland near the river is occurring. Water begins to back up into several creeks and streams in the Jackson area."
   },
   {
    "stage": 26,
    "statement": "Roads near the river in Lefleurs Bluff State Park begin to flood."
   },
   {
    "stage": 24,
    "statement": "The Jackson waste water treatment plant loses its natural outflow and must initiate pumping."
   }
  ]
